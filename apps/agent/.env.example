# 将这些值填入同目录.env；真实key只保留在.env中。
# Web 通常用 pnpm ui -- --user alice 启动，由启动器设置服务端开发身份。
# 直接使用 next dev/start 时可配置 SUPPORT_DEV_USER=alice；它不是业务登录认证。
OPENAI_API_KEY=请填写中转站APIkey

# 填中转站给的API基础地址，通常带/v1；不要填完整/responses或/chat/completions地址。
OPENAI_BASE_URL=请填写中转站BaseURL

# 填中转站实际支持的模型ID，不要把codex产品名称当作模型ID。
OPENAI_MODEL=请填写中转站模型ID

# 默认先按Responses接口配置；若中转站仅支持Chat Completions，改为chat-completions。
OPENAI_API_MODE=responses

# 运行 node scripts/init-knowledge-integration.mjs 为两端生成相同的服务端密钥。
# 以下均只保留在服务端 .env，不发送到浏览器。
AGENT_KNOWLEDGE_WEB_SECRET=
KNOWLEDGE_SUPPORT_AGENT_SECRET=
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:3200

# 必填：数据库需预先存在；程序初始化 public 中的官方 checkpoint 表。
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agent-support

# 可选追踪；不部署 Agent Server。启用时填写 LangSmith（非模型）的 API Key。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# 截图中的新版 Agent 工作区：对应 leeway-support → Local → Tracing。
LANGSMITH_AGENT_ID=leeway-support
LANGSMITH_AGENT_ENVIRONMENT=local
# 老版 project 工作区才使用此项，不能与上面两项同时配置：
# LANGSMITH_PROJECT=leeway-support-dev
# 必须与账号区域匹配；以下为默认 US，其他区域使用官方给出的 API endpoint。
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 上传超时（毫秒），默认 10000；不是模型请求超时。
LANGSMITH_TIMEOUT_MS=10000
# 默认上传经过基础凭据脱敏的问答；设为 true 则完全隐藏对应输入/输出。
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false
