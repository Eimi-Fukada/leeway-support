{
  "name": "@leeway-support/agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "ui": "node scripts/ui.mjs",
    "ui:start": "node scripts/ui.mjs --production",
    "build": "next build",
    "test": "tsx --import ./tests/setup.ts --test tests/*.test.ts",
    "test:postgres": "tsx --import ./tests/setup.ts --test tests/postgres.integration.ts tests/information.postgres.ts tests/conversation.postgres.ts",
    "eval:behavior": "tsx evals/index.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/runtime": "1.79.1",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/openai": "1.6.3",
    "langchain": "1.5.18",
    "langsmith": "0.11.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  }
}
