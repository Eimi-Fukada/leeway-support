# 与 Agent 使用同一个现有产品数据库，知识库应用管理 public.knowledge_* 表。
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agent-support
# 浏览器访问的完整 origin；上线经过 HTTPS 代理时填写外部 HTTPS origin。
KNOWLEDGE_APP_URL=http://127.0.0.1:3200
# 可选：私有原文目录，默认应用目录下 .knowledge-storage，不放 public。
# KNOWLEDGE_STORAGE_DIR=E:/GraceProject/knowledge-files
