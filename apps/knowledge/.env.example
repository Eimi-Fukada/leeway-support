# 与 Agent 使用同一个现有产品数据库，知识库应用管理 public.knowledge_* 表。
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agent-support
# 浏览器访问的完整 origin；上线经过 HTTPS 代理时填写外部 HTTPS origin。
KNOWLEDGE_APP_URL=http://127.0.0.1:3200
AGENT_SERVICE_URL=http://127.0.0.1:3100
# 由根目录 scripts/init-knowledge-integration.mjs 初始化，必须与 Agent 端对应。
AGENT_KNOWLEDGE_WEB_SECRET=
KNOWLEDGE_SUPPORT_AGENT_SECRET=
# 可选：私有原文目录，默认应用目录下 .knowledge-storage，不放 public。
# KNOWLEDGE_STORAGE_DIR=E:/GraceProject/knowledge-files

# 嵌入独立于 Agent 聊天模型。云端可切换 openai-compatible，BASE_URL 包含供应商的 /v1。
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
# 人工固定的模型版本/摘要；更换权重必须更新并重建向量，不能混用。
EMBEDDING_MODEL_REVISION=ac6da0dfba84a81fdbfbaf330198c33cd77c4cdfc53e8bc50eb581914a15621d
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_MS=120000
EMBEDDING_BATCH_SIZE=8
EMBEDDING_API_KEY=
EMBEDDING_DOCUMENT_PREFIX=
# Qwen 查询端使用任务说明，文档端不加指令；其他模型按官方用法配置。字面量 \n 会转换成换行。
EMBEDDING_QUERY_PREFIX="Instruct: Given a customer support question, retrieve relevant passages that answer the question\nQuery: "

# Qdrant 地址为服务端配置；collection 名称会追加完整嵌入配置 ID，避免混用模型。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=leeway_knowledge
QDRANT_TIMEOUT_MS=30000
QDRANT_BATCH_SIZE=32
