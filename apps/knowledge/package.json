{
  "name": "@leeway-support/knowledge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "db:init": "tsx scripts/init-db.ts",
    "db:status": "tsx scripts/db-status.ts",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --test tests/postgres.integration.ts tests/documents.postgres.ts tests/schema.postgres.ts tests/ingestion.postgres.ts tests/embeddings.postgres.ts",
    "test:qdrant": "tsx --test tests/indexing.qdrant.ts"
  },
  "dependencies": {
    "@langchain/core": "1.2.20",
    "@langchain/textsplitters": "1.0.2",
    "mammoth": "1.11.0",
    "marked": "18.1.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "yauzl": "3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "2.10.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
