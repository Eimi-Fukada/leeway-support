{
  "name": "leeway-support",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "pnpm --filter @leeway-support/agent dev",
    "start": "pnpm --filter @leeway-support/agent start",
    "test": "turbo run test",
    "test:postgres": "pnpm --filter @leeway-support/agent test:postgres",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
