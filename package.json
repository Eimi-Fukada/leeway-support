{
  "name": "leeway-support",
  "private": true,
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "pnpm --filter @leeway-support/agent dev",
    "start": "pnpm --filter @leeway-support/agent start",
    "ui": "pnpm --filter @leeway-support/agent ui",
    "ui:start": "pnpm --filter @leeway-support/agent ui:start",
    "knowledge:dev": "pnpm --filter @leeway-support/knowledge dev",
    "knowledge:start": "pnpm --filter @leeway-support/knowledge start",
    "knowledge:db:init": "pnpm --filter @leeway-support/knowledge db:init",
    "knowledge:db:status": "pnpm --filter @leeway-support/knowledge db:status",
    "knowledge:worker": "pnpm --filter @leeway-support/knowledge worker",
    "agent:db:init": "pnpm --filter @leeway-support/agent db:init",
    "agent:db:status": "pnpm --filter @leeway-support/agent db:status",
    "db:init": "pnpm agent:db:init && pnpm knowledge:db:init",
    "db:status": "pnpm -r --no-bail --workspace-concurrency=1 run db:status",
    "knowledge:test:postgres": "pnpm --filter @leeway-support/knowledge test:postgres",
    "knowledge:test:qdrant": "pnpm --filter @leeway-support/knowledge test:qdrant",
    "knowledge:test:http": "pnpm --filter @leeway-support/knowledge test:http",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:postgres": "pnpm --filter @leeway-support/agent test:postgres",
    "eval:behavior": "pnpm --filter @leeway-support/agent eval:behavior",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
