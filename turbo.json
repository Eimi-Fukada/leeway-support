{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_MODEL", "OPENAI_API_MODE"]
    },
    "start": {
      "cache": false,
      "passThroughEnv": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_MODEL", "OPENAI_API_MODE"]
    },
    "debug": {
      "cache": false,
      "passThroughEnv": ["OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_MODEL", "OPENAI_API_MODE"]
    },
    "test": {
      "cache": false
    },
    "typecheck": {
      "outputs": []
    }
  }
}
